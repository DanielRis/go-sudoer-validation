Defaults syslog=authpriv, syslog_goodpri=notice, syslog_badpri=alert, !syslog
Defaults passwd_tries=5, loglinelen=0, !loglinelen
Defaults timestamp_timeout=-1, passwd_timeout=2.5, umask=0022, !umask
Defaults lecture=always, !lecture, lecture
Defaults listpw=never, verifypw=any
Defaults env_keep+="DISPLAY XAUTHORITY", env_check-=TZ, !env_delete
Defaults command_timeout=5m, !command_timeout
Defaults rlimit_core=0, rlimit_nofile="1024,4096", rlimit_stack=infinity, rlimit_cpu=default
Defaults log_format=json, timestamp_type=tty, intercept_type=trace
Defaults closefrom=3, iolog_mode=0600, runcwd=*
Defaults editor=/usr/bin/vi:/usr/bin/nano
